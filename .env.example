# =====================================================================
# SAVELIX Environment Variables Template
# =====================================================================
# Copy this file to .env.local for local overrides.
# Never commit real secrets or production .env files to version control.
#
# VITE_BASE_PATH:
# - Optional base path override for deployment (e.g., /<repository-name>/ or / for custom domains).
# - When left blank or unset, Vite defaults to '/' in local development and
#   automatically derives '/<repo-name>/' from GITHUB_REPOSITORY during GitHub Actions runs.
VITE_BASE_PATH=

# SAVELIX Central CRM Public API Base URL
# Points to the public lead ingestion endpoint (POST /api/v1/public/leads)
VITE_API_BASE_URL=http://localhost:4000/api/v1
